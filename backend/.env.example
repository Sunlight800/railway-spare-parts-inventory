# Application Settings
APP_NAME="AI-Powered Automatic Block Planning to Maximize Asset Availability"
APP_SUBTITLE="MUSIC-3D-Based Spare-Part Inventory Intelligence for Indian Railways"

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL=sqlite:///./railway_inventory.db

# Production PostgreSQL (Render Managed PostgreSQL or Neon / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Analytical Parameters
DEMO_MODE=True
SIMULATION_DEFAULT_RUNS=500
ABC_A_THRESHOLD=70.0
ABC_B_THRESHOLD=90.0
HML_H_THRESHOLD=25000.0
HML_M_THRESHOLD=5000.0
